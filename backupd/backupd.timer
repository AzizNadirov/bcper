[Unit]
Description=backupd timer — run cloud backup periodically

[Timer]
# Run once per day, 15 minutes after the system boots (avoids boot congestion)
OnBootSec=15min
OnUnitActiveSec=24h

# Randomise start within 30 minutes to avoid thundering herd on shared network
RandomizedDelaySec=1800

# Persist — if the machine was off at the scheduled time, run on next boot
Persistent=true

[Install]
WantedBy=timers.target
